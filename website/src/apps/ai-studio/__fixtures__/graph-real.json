C-05", "kind": "trace"}, {"from": "tonec:friendly-copy", "to": "KDU-AC-05", "kind": "trace"}, {"from": "tonec:friendly-copy", "to": "KDU-AC-01", "kind": "trace"}], "srs": [{"id": "SR-R1-1", "text": "\u7a7a\u9644\u4ef6\u65f6\u9009\u62e9 test2.txt\uff0c\u9644\u4ef6\u540d\u663e\u793a test2.txt\uff08\u9996\u4e2a\u4e0a\u4f20\u6210\u529f\u8def\u5f84\uff09", "realizes": ["domc:attachment-first-upload"], "anchor": {"ref": "R1-1", "quote": "\u5728\u9644\u4ef6\u4e3a\u7a7a\u7684\u7f16\u8f91\u77e5\u8bc6\u8868\u5355\u4e2d\uff0c\u901a\u8fc7 testid=upload-file-input \u9009\u62e9\u6587\u4ef6 test2.txt \u540e\uff0ctestid=attachment-filename \u663e\u793a\u6587\u672c\u300ctest2.txt\u300d\u3002"}}, {"id": "SR-R1-2", "text": "\u9644\u4ef6\u975e\u7a7a\u65f6\u518d\u4e0a\u4f20\uff0c\u51fa\u73b0\u9010\u5b57\u62a5\u9519\uff08\u9700\u6c42 1 \u4e3b\u5224\u5b9a\uff09", "realizes": ["errc:upload-duplicate-rejected"], "anchor": {"ref": "R1-2", "quote": "\u5728\u9644\u4ef6\u5df2\u4e3a test2.txt \u7684\u7f16\u8f91\u77e5\u8bc6\u8868\u5355\u4e2d\uff0c\u518d\u6b21\u901a\u8fc7 testid=upload-file-input \u9009\u62e9\u6587\u4ef6 test3.txt \u540e\uff0ctestid=upload-error \u51fa\u73b0\u4e14\u6587\u672c\u9010\u5b57\u7b49\u4e8e\u300c\u5df2\u7ecf\u4e0a\u4f20\u8fc7\u6587\u6863\u5566\uff0c\u5982\u9700\u4e0a\u4f20\u65b0\u7684\u6587\u6863\uff0c\u8bf7\u5148\u5220\u9664\u5df2\u4e0a\u4f20\u7684\u6587\u4ef6\u54e6\u3002\u300d\uff08\u62df\u5b9a\u6587\u6848\uff0c\u89c1 OPEN-questions.md OPEN-3\uff09\u3002"}, "openRef": "OPEN-3", "adopted": true}, {"id": "SR-R1-3", "text": "\u62a5\u9519\u540e\u9644\u4ef6\u4e0e\u7248\u672c\u53f7\u90fd\u4e0d\u53d8\uff08\u65e0\u526f\u4f5c\u7528\uff09", "realizes": ["domc:no-side-effect-on-reject"], "anchor": {"ref": "R1-3", "quote": "R1-2 \u7684\u62a5\u9519\u53d1\u751f\u540e\uff0ctestid=attachment-filename \u4ecd\u663e\u793a\u300ctest2.txt\u300d\uff0c\u4e14 testid=doc-version \u663e\u793a\u503c\u4e0e\u62a5\u9519\u524d\u4e00\u81f4\u3002"}}, {"id": "SR-R1-4", "text": "\u9644\u4ef6\u975e\u7a7a\u65f6\u6709\u5220\u9664\u6309\u94ae\uff0c\u5220\u9664\u540e\u8fdb\u5165\u7a7a\u6001", "realizes": ["domc:remove-attachment-to-empty"], "anchor": {"ref": "R1-4", "quote": "\u9644\u4ef6\u975e\u7a7a\u65f6\u8868\u5355\u4e2d\u5b58\u5728 testid=btn-remove-attachment\uff1b\u70b9\u51fb\u5b83\u540e\uff0ctestid=attachment-filename \u6d88\u5931\uff0c\u4e14 testid=attachment-empty \u663e\u793a\u6587\u672c\u300c\u6682\u672a\u4e0a\u4f20\u6587\u6863\u300d\u3002"}}, {"id": "SR-R1-5", "text": "\u5220\u9664\u540e\u53ef\u518d\u4f20\u65b0\u6587\u4ef6\u4e14\u62a5\u9519\u6d88\u5931\uff08\u9700\u6c42 1 \u4f8b\u5916\u5206\u652f\uff09", "realizes": ["domc:reupload-after-remove"], "anchor": {"ref": "R1-5", "quote": "\u5220\u9664\u5df2\u4e0a\u4f20\u9644\u4ef6\u540e\uff0c\u518d\u901a\u8fc7 testid=upload-file-input \u9009\u62e9\u6587\u4ef6 test3.txt\uff0ctestid=attachment-filename \u663e\u793a\u300ctest3.txt\u300d\uff0c\u4e14 testid=upload-error \u4e0d\u5b58\u5728\u3002"}}, {"id": "SR-R1-6", "text": "\u91cd\u65b0\u6253\u5f00\u7f16\u8f91\u8868\u5355\u540e\u62a5\u9519\u4e0d\u6b8b\u7559", "realizes": ["domc:no-stale-error"], "anchor": {"ref": "R1-6", "quote": "testid=upload-error \u51fa\u73b0\u540e\uff0c\u91cd\u65b0\u6253\u5f00\u8be5\u77e5\u8bc6\u7684\u7f16\u8f91\u8868\u5355\uff0ctestid=upload-error \u4e0d\u5b58\u5728\u3002"}}, {"id": "SR-R2-1", "text": "\u4e0d\u4e0a\u4f20\u4fdd\u5b58\uff1a\u4fdd\u7559\u539f\u6587\u6863\u4e0e\u539f\u7248\u672c\u53f7\uff08\u9700\u6c42 2 \u524d\u534a\uff09", "realizes": ["savec:no-upload-keeps-doc-and-version"], "anchor": {"ref": "R2-1", "quote": "\u5bf9\u5df2\u6302\u9644\u4ef6 old.txt \u7684\u77e5\u8bc6\u6253\u5f00\u7f16\u8f91\u8868\u5355\uff0c\u4e0d\u6267\u884c\u4efb\u4f55\u4e0a\u4f20\u64cd\u4f5c\uff0c\u70b9\u51fb testid=btn-save-knowledge \u4fdd\u5b58\u6210\u529f\u540e\uff0c\u91cd\u65b0\u6253\u5f00\u8be5\u77e5\u8bc6\u7684\u7f16\u8f91\u8868\u5355\uff0ctestid=attachment-filename \u663e\u793a\u300cold.txt\u300d\uff0c\u4e14 testid=doc-version \u663e\u793a\u503c\u4e0e\u4fdd\u5b58\u524d\u4e00\u81f4\u3002"}, "openRef": "OPEN-2"}, {"id": "SR-R2-2", "text": "\u4e0a\u4f20\u65b0\u6587\u4ef6\u4fdd\u5b58\uff1av1 \u5347 v2 \u4e14\u9644\u4ef6\u66f4\u6362\uff08\u9700\u6c42 2 \u540e\u534a\uff09", "realizes": ["savec:new-file-upgrades-version"], "anchor": {"ref": "R2-2", "quote": "\u77e5\u8bc6\u5f53\u524d\u7248\u672c\u53f7\u4e3a v1\uff0c\u6253\u5f00\u7f16\u8f91\u8868\u5355\uff0c\u901a\u8fc7 testid=upload-file-input \u9009\u62e9\u6587\u4ef6 new.txt\uff0c\u70b9\u51fb testid=btn-save-knowledge \u4fdd\u5b58\u6210\u529f\u540e\uff0c\u91cd\u65b0\u6253\u5f00\u8be5\u77e5\u8bc6\u7684\u7f16\u8f91\u8868\u5355\uff0ctestid=doc-version \u663e\u793a\u300cv2\u300d\uff0c\u4e14 testid=attachment-filename \u663e\u793a\u300cnew.txt\u300d\u3002"}, "openRef": "OPEN-1", "adopted": true}, {"id": "SR-R2-3", "text": "\u7248\u672c\u53f7\u53ef\u8fde\u7eed\u5347\u7ea7 v2 \u5347 v3", "realizes": [], "anchor": {"ref": "R2-3", "quote": "\u5bf9\u7248\u672c\u53f7\u4e3a v2\u3001\u9644\u4ef6\u4e3a new.txt \u7684\u77e5\u8bc6\u91cd\u590d R2-2 \u7684\u64cd\u4f5c\uff08\u6539\u9009\u6587\u4ef6 new2.txt\uff09\uff0c\u4fdd\u5b58\u6210\u529f\u540e\u91cd\u65b0\u6253\u5f00\u7f16\u8f91\u8868\u5355\uff0ctestid=doc-version \u663e\u793a\u300cv3\u300d\uff0c\u4e14 testid=attachment-filename \u663e\u793a\u300cnew2.txt\u300d\u3002"}, "openRef": "OPEN-1", "adopted": true}, {"id": "SR-R2-4", "text": "\u5347\u7248\u4e0d\u5220\u9664\u65e7\u7248\u672c\u8bb0\u5f55", "realizes": ["savec:history-preserved"], "anchor": {"ref": "R2-4", "quote": "R2-2 \u4fdd\u5b58\u6210\u529f\u540e\uff0c\u539f\u59cb\u6587\u4ef6 old.txt \u4ecd\u53ef\u88ab\u8be5\u77e5\u8bc6\u7684\u5386\u53f2\u7248\u672c\u8bbf\u95ee\u5230\uff0c\u5373\u5347\u7ea7\u7248\u672c\u53f7\u4e0d\u5220\u9664\u65e7\u7248\u672c\u8bb0\u5f55\u3002"}, "openRef": "OPEN-2", "adopted": true}, {"id": "SR-R3-1", "text": "\u9644\u4ef6\u533a\u5e38\u9a7b\u4e0a\u4f20\u89c4\u5219\u63d0\u793a\u6761\uff08\u9700\u6c42 3 \u4e3b\u5224\u5b9a\uff09", "realizes": ["hintc:upload-hint"], "anchor": {"ref": "R3-1", "quote": "\u7f16\u8f91\u77e5\u8bc6\u8868\u5355\u6253\u5f00\u540e\uff0ctestid=upload-hint \u5b58\u5728\u4e14\u6587\u672c\u9010\u5b57\u7b49\u4e8e\u300c\u7f16\u8f91\u77e5\u8bc6\u53ea\u80fd\u4e0a\u4f20\u4e00\u4e2a\u6587\u6863\uff0c\u4e0d\u80fd\u4e0a\u4f20\u591a\u4e2a\u6587\u6863\u3002\u9700\u8981\u66f4\u6362\u6587\u6863\u65f6\uff0c\u8bf7\u5148\u5220\u9664\u5df2\u4e0a\u4f20\u7684\u6587\u6863\u3002\u300d\uff08\u62df\u5b9a\u6587\u6848\uff0c\u89c1 OPEN-questions.md OPEN-3\uff09\u3002"}, "openRef": "OPEN-3", "adopted": true}, {"id": "SR-R3-2", "text": "\u63d0\u793a\u6761\u5728\u7a7a\u6001\u4e0e\u975e\u7a7a\u6001\u90fd\u5e38\u9a7b\u4e14\u6587\u6848\u4e00\u81f4", "realizes": [], "anchor": {"ref": "R3-2", "quote": "\u9644\u4ef6\u4e3a\u7a7a\u4e0e\u9644\u4ef6\u975e\u7a7a\u4e24\u79cd\u72b6\u6001\u4e0b\uff0ctestid=upload-hint \u90fd\u5b58\u5728\u4e14\u6587\u672c\u4e00\u81f4\u3002"}}, {"id": "SR-T-1", "text": "\u63d0\u793a\u4e0e\u62a5\u9519\u6587\u6848\u8bed\u6c14\u8d1f\u5224\u5b9a\uff08\u9700\u6c42 3 \u7b2c\u4e8c\u53e5\uff09", "realizes": ["tonec:friendly-copy"], "anchor": {"ref": "T-1", "quote": "testid=upload-hint \u4e0e testid=upload-error \u7684\u6587\u672c\u90fd\u4e0d\u542b\u300c\u7981\u6b62\u300d\u300c\u4e25\u7981\u300d\u300c\u4e0d\u5141\u8bb8\u300d\u300c\u9519\u8bef\u64cd\u4f5c\u300d\u5b57\u6837\u3002"}}, {"id": "SR-B-1", "text": "\u7248\u672c\u53f7\u663e\u5f0f\u89c4\u5219\uff1av+\u6b63\u6574\u6570\uff0c\u4fdd\u5b58\u6210\u529f\u6362\u6587\u4ef6\u65f6\u6574\u6570\u4f4d\u52a0\u4e00", "realizes": ["savec:version-bump-rule"], "anchor": {"ref": "B-1", "quote": "\u7248\u672c\u53f7\u683c\u5f0f\u4e3a v + \u6b63\u6574\u6570\uff0c\u521d\u59cb\u7248\u672c\u663e\u793a\u300cv1\u300d\uff1b\u6bcf\u6b21\u300c\u4e0a\u4f20\u65b0\u6587\u4ef6\u5e76\u4fdd\u5b58\u6210\u529f\u300d\u7248\u672c\u53f7\u6574\u6570\u90e8\u5206\u52a0 1\uff08v1 \u2192 v2 \u2192 v3\uff09\u3002\uff08\u62df\u5b9a\u89c4\u5219\uff0c\u89c1 OPEN-questions.md OPEN-1\uff09"}, "openRef": "OPEN-1", "adopted": true}, {"id": "SR-B-2", "text": "\u62d2\u7edd\u8def\u5f84\u96f6\u526f\u4f5c\u7528", "realizes": [], "anchor": {"ref": "B-2", "quote": "\u62a5\u9519\u65f6\u4e0d\u6539\u9644\u4ef6\u3001\u4e0d\u6539\u7248\u672c\u53f7\u3001\u4e0d\u4ea7\u751f\u4efb\u4f55\u4fdd\u5b58\u526f\u4f5c\u7528\u3002"}}, {"id": "SR-B-3", "text": "\u5355\u9644\u4ef6\u9650\u5236\u9488\u5bf9\u5f85\u4fdd\u5b58\u8349\u7a3f\uff0c\u754c\u9762\u4e0a\u6c38\u4e0d\u51fa\u73b0\u4e24\u4e2a\u5f85\u4fdd\u5b58\u9644\u4ef6", "realizes": [], "anchor": {"ref": "B-3", "quote": "\u5355\u9644\u4ef6\u9650\u5236\u5224\u5b9a\u7684\u662f\u5f53\u524d\u8868\u5355\u5185\u7684\u5f85\u4fdd\u5b58\u9644\u4ef6\uff1b\u754c\u9762\u4e0a\u4e0d\u51fa\u73b0\u4e24\u4e2a\u9644\u4ef6\u540c\u65f6\u6302\u5728\u5f85\u4fdd\u5b58\u72b6\u6001\u7684\u60c5\u51b5\uff08\u7531 R1-2 \u62d2\u7edd\u8def\u5f84\u4fdd\u8bc1\uff09\u3002"}}, {"id": "SR-B-4", "text": "\u4e0d\u5b58\u5728\u76f4\u63a5\u66ff\u6362\u8def\u5f84\uff0c\u5fc5\u987b\u5148\u5220\u540e\u4f20", "realizes": [], "anchor": {"ref": "B-4", "quote": "\u4e0a\u4f20\u5373\u62a5\u9519\u3001\u5220\u9664\u540e\u624d\u53ef\u518d\u4f20\uff0c\u672c\u9700\u6c42\u96c6\u5185\u4e0d\u5b58\u5728\u300c\u76f4\u63a5\u66ff\u6362\u300d\u8def\u5f84\u3002"}}, {"id": "SR-B-5", "text": "\u5220\u9664\u540e\u4e0d\u4e0a\u4f20\u76f4\u63a5\u4fdd\u5b58\u7684\u7248\u672c\u53f7\u884c\u4e3a\u4e0d\u5224\u5b9a\uff08OPEN-4 \u8fb9\u754c\u58f0\u660e\uff09", "realizes": [], "anchor": {"ref": "B-5", "quote": "R2 \u4e0e B-1 \u7684\u7248\u672c\u53f7\u65ad\u8a00\u53ea\u5224\u5b9a\u300c\u4e0a\u4f20\u65b0\u6587\u4ef6\u5e76\u4fdd\u5b58\u6210\u529f\u300d\u540e\u7684\u5347\u7ea7\uff1b\u300c\u5220\u9664\u9644\u4ef6\u540e\u4e0d\u4e0a\u4f20\u76f4\u63a5\u4fdd\u5b58\u300d\u7684\u7248\u672c\u53f7\u884c\u4e3a\u539f\u6587\u65e0\u4f9d\u636e\uff0c\u672c\u9700\u6c42\u96c6\u4e0d\u5224\u5b9a\uff0c\u5df2\u5217 OPEN\u3002"}, "openRef": "OPEN-4"}, {"id": "SR-OP-1", "text": "\u64cd\u4f5c\u5b9a\u4e49\uff1a\u9009\u62e9\u6587\u4ef6\u662f\u5916\u90e8 UI \u64cd\u4f5c", "realizes": [], "anchor": {"ref": "OP-DEF-1", "quote": "\u672c\u6587\u4e2d\u300c\u901a\u8fc7 testid=upload-file-input \u9009\u62e9\u6587\u4ef6 X\u300d\u6307\u5916\u90e8 UI \u64cd\u4f5c\uff1a\u6253\u5f00\u8be5\u63a7\u4ef6\u7684\u6587\u4ef6\u9009\u62e9\u6846\uff0c\u5728\u5176\u4e2d\u9009\u4e2d\u6307\u5b9a\u6587\u4ef6 X\u3002"}}, {"id": "SR-OP-2", "text": "\u64cd\u4f5c\u5b9a\u4e49\uff1a\u91cd\u65b0\u6253\u5f00\u7f16\u8f91\u8868\u5355\u662f\u5916\u90e8 UI \u64cd\u4f5c\uff0c\u6240\u6709 DOM \u65ad\u8a00\u524d\u5148\u91cd\u65b0\u62c9\u53d6", "realizes": [], "anchor": {"ref": "OP-DEF-2", "quote": "\u672c\u6587\u4e2d\u300c\u91cd\u65b0\u6253\u5f00\u8be5\u77e5\u8bc6\u7684\u7f16\u8f91\u8868\u5355\u300d\u6307\u5916\u90e8 UI \u64cd\u4f5c\uff1a\u5173\u95ed\u5f53\u524d\u7f16\u8f91\u8868\u5355\uff0c\u518d\u4ece\u77e5\u8bc6\u5217\u8868\u518d\u6b21\u6253\u5f00\u540c\u4e00\u6761\u77e5\u8bc6\u7684\u7f16\u8f91\u8868\u5355\u3002"}}]}}